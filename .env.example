# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# Phase 00 — Postgres connection string from Neon (or any Postgres host for local dev)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Phase 01 — Auth.js (v5 reads AUTH_SECRET; NEXTAUTH_SECRET also works)
AUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Phase 03 — YouTube Data API (search.list costs 100 units; default quota is
# 10,000/day — see Build Spec v2 §07 before removing the SearchCache guard)
YOUTUBE_API_KEY=""

# Phase 06 — AI enrichment layer (resource classification, wizard notes field)
AI_API_KEY=""

# Owner insights — opt in only when deploying the reviewed feature.
INSIGHTS_ENABLED="false"
OWNER_REPORT_EMAIL="parthmadlani0201@gmail.com"
OWNER_EMAIL_ENABLED="false"
# Verified sender in Resend, e.g. Init <reports@your-verified-domain>
OWNER_EMAIL_FROM=""
RESEND_API_KEY=""
# Generate independent random secrets of at least 32 characters.
CRON_SECRET=""
MONITOR_SECRET=""
# vercel.json: 04:30 UTC / 10:00 Asia/Kolkata daily; Monday also sends weekly.
# Email additionally requires VERCEL_ENV=production and NODE_ENV=production.
