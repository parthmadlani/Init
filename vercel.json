{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:migrate:deploy && npm run db:seed && npm run build",
  "git": {
    "deploymentEnabled": {
      "codex/full-stack-foundations": false,
      "codex/javascript-foundations": false,
      "codex/typescript-react": false,
      "codex/rewind-adaptation": false,
      "codex/owner-insights": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/owner-reports",
      "schedule": "30 4 * * *"
    }
  ]
}
